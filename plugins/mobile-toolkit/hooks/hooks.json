{
  "$schema": "https://claude.ai/schemas/hooks.json",
  "description": "Mobile toolkit hooks for build automation and code quality",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash.*(swift build|xcodebuild)",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Tip: Pipe to xcsift for structured output: | xcsift -f toon'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit.*\\.swift$",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Consider running SwiftLint: swiftlint lint --path <file>'"
          }
        ]
      },
      {
        "matcher": "Bash.*xcodebuild.*test",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Tests complete. Run /analyze-build --coverage for coverage report.'"
          }
        ]
      }
    ]
  }
}
